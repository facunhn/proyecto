# Si dejás esto vacío, la app usa datos mock locales (login, signup y promociones simulados).
# Para conectar el backend real (Supabase), completá estos dos valores:
# los encontrás en tu proyecto de Supabase, en Project Settings → API Keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Para las notificaciones push reales: la clave pública que te da
# `npx web-push generate-vapid-keys` (ver instrucciones del asistente).
VITE_VAPID_PUBLIC_KEY=
